# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，不会进入代码库与投递包

# DeepSeek 平台密钥（用于向模型平台认证，与 Agent OAuth 凭据相互独立）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口配置（以实际账户可用性验证后固定）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Keycloak 授权服务（阶段 0 验证后固定实际值）
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=agent-range
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/agent-range

# Keycloak bootstrap 管理员（仅本机管理 realm 使用，不参与靶场业务身份）
KC_ADMIN_USERNAME=range-admin
KC_ADMIN_PASSWORD=changeme-random

# 客服 Agent 客户端凭据（client_credentials，私密保管）
CUSTOMER_AGENT_CLIENT_ID=customer-service-agent
CUSTOMER_AGENT_CLIENT_SECRET=changeme

# 退款 Agent 客户端凭据（独立于客服 Agent，不得复用）
REFUND_AGENT_CLIENT_ID=refund-agent
REFUND_AGENT_CLIENT_SECRET=changeme

# 工具服务受众
TOOLS_AUDIENCE=tools-service
